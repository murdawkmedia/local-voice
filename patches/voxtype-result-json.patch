index 0000000..717db0a
--- /dev/null
+++ 2/src/app/result_json.rs
@@ -0,0 +1,175 @@
+//! Atomic, private machine results for one-shot file transcription.
+use anyhow::Context;
+use std::fs;
+use std::io::Write;
+use std::os::unix::fs::{MetadataExt, PermissionsExt};
+use std::path::Path;
+
+pub(super) fn publish_result(
+    path: &Path,
+    engine: &str,
+    transcribe: impl FnOnce() -> anyhow::Result<String>,
+) -> anyhow::Result<()> {
+    let parent = path
+        .parent()
+        .filter(|p| !p.as_os_str().is_empty())
+        .unwrap_or(Path::new("."));
+    let metadata = fs::symlink_metadata(parent).context("result directory unavailable")?;
+    anyhow::ensure!(
+        metadata.is_dir()
+            && metadata.uid() == unsafe { libc::geteuid() }
+            && metadata.permissions().mode() & 0o077 == 0,
+        "result directory must be an owned private directory (mode 0700)"
+    );
+    anyhow::ensure!(path.file_name().is_some(), "result file name is required");
+    match fs::symlink_metadata(path) {
+        Ok(_) => anyhow::bail!("result destination already exists"),
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+        Err(e) => return Err(e).context("cannot inspect result destination"),
+    }
+
+    // Failures propagate before any result or temporary result is created.
+    let text = transcribe()?;
+    let result = serde_json::json!({
+        "schemaVersion": 1,
+        "status": if text.is_empty() { "empty" } else { "success" },
+        "text": text,
+        "engine": engine,
+    });
+    let mut temporary = tempfile::Builder::new()
+        .prefix(".voxtype-result-")
+        .tempfile_in(parent)?;
+    temporary
+        .as_file()
+        .set_permissions(fs::Permissions::from_mode(0o600))?;
+    serde_json::to_writer(temporary.as_file_mut(), &result)?;
+    temporary.as_file_mut().write_all(b"\n")?;
+    temporary.as_file().sync_all()?;
+    rename_noreplace(temporary.path(), path).context("cannot publish result")?;
+    // NamedTempFile's drop only removes its old random name, never `path`.
+    Ok(())
+}
+
+#[cfg(target_os = "linux")]
+fn rename_noreplace(source: &Path, destination: &Path) -> std::io::Result<()> {
+    use std::ffi::CString;
+    use std::os::unix::ffi::OsStrExt;
+    let source = CString::new(source.as_os_str().as_bytes())?;
+    let destination = CString::new(destination.as_os_str().as_bytes())?;
+    // RENAME_NOREPLACE is atomic and closes the check/rename overwrite race.
+    // Both paths are NUL-terminated, live through this call, and share a directory.
+    let result = unsafe {
+        libc::renameat2(
+            libc::AT_FDCWD,
+            source.as_ptr(),
+            libc::AT_FDCWD,
+            destination.as_ptr(),
+            libc::RENAME_NOREPLACE,
+        )
+    };
+    if result == 0 {
+        Ok(())
+    } else {
+        Err(std::io::Error::last_os_error())
+    }
+}
+
+#[cfg(not(target_os = "linux"))]
+fn rename_noreplace(_source: &Path, _destination: &Path) -> std::io::Result<()> {
+    Err(std::io::Error::new(
+        std::io::ErrorKind::Unsupported,
+        "--result-json requires Linux atomic no-replace rename",
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+    use std::os::unix::fs::PermissionsExt;
+
+    fn private_dir() -> tempfile::TempDir {
+        let dir = tempfile::tempdir().unwrap();
+        fs::set_permissions(dir.path(), fs::Permissions::from_mode(0o700)).unwrap();
+        dir
+    }
+
+    #[test]
+    fn unicode_and_newlines_are_lossless_and_artifact_is_private() {
+        let dir = private_dir();
+        let path = dir.path().join("result.json");
+        let text = "  Café — 日本語\nSecond line: \"quoted\" \\ tail\n";
+        publish_result(&path, "parakeet", || Ok(text.to_owned())).unwrap();
+        let result: serde_json::Value = serde_json::from_slice(&fs::read(&path).unwrap()).unwrap();
+        assert_eq!(
+            result,
+            serde_json::json!({
+                "schemaVersion": 1, "status": "success", "text": text, "engine": "parakeet"
+            })
+        );
+        assert_eq!(
+            fs::metadata(&path).unwrap().permissions().mode() & 0o777,
+            0o600
+        );
+        assert_eq!(fs::read_dir(dir.path()).unwrap().count(), 1);
+    }
+
+    #[test]
+    fn empty_recognition_is_an_explicit_empty_result() {
+        let dir = private_dir();
+        let path = dir.path().join("result.json");
+        publish_result(&path, "whisper", || Ok(String::new())).unwrap();
+        let result: serde_json::Value = serde_json::from_slice(&fs::read(path).unwrap()).unwrap();
+        assert_eq!(result["status"], "empty");
+        assert_eq!(result["text"], "");
+        assert_eq!(result["engine"], "whisper");
+    }
+
+    #[test]
+    fn existing_destination_is_preserved_and_inference_is_not_started() {
+        let dir = private_dir();
+        let path = dir.path().join("result.json");
+        fs::write(&path, b"keep existing bytes").unwrap();
+        let error = publish_result(&path, "whisper", || panic!("must reject before inference"));
+        assert!(error.is_err());
+        assert_eq!(fs::read(&path).unwrap(), b"keep existing bytes");
+        assert_eq!(fs::read_dir(dir.path()).unwrap().count(), 1);
+    }
+
+    #[test]
+    fn failed_transcription_does_not_create_a_result_or_temporary_file() {
+        let dir = private_dir();
+        let path = dir.path().join("result.json");
+        let error = publish_result(&path, "whisper", || {
+            anyhow::bail!("synthetic recognition failure")
+        });
+        assert!(format!("{}", error.unwrap_err()).contains("synthetic recognition failure"));
+        assert!(!path.exists());
+        assert_eq!(fs::read_dir(dir.path()).unwrap().count(), 0);
+    }
+
+    #[test]
+    fn racing_destination_is_never_overwritten() {
+        let dir = private_dir();
+        let path = dir.path().join("result.json");
+        let error = publish_result(&path, "whisper", || {
+            fs::write(&path, b"concurrent owner").unwrap();
+            Ok("new recognition".to_owned())
+        });
+        assert!(error.is_err());
+        assert_eq!(fs::read(&path).unwrap(), b"concurrent owner");
+        assert_eq!(fs::read_dir(dir.path()).unwrap().count(), 1);
+    }
+
+    #[test]
+    fn destination_symlink_is_preserved() {
+        let dir = private_dir();
+        let target = dir.path().join("target");
+        let path = dir.path().join("result.json");
+        fs::write(&target, b"target bytes").unwrap();
+        std::os::unix::fs::symlink(&target, &path).unwrap();
+        assert!(publish_result(&path, "parakeet", || panic!("must reject symlink")).is_err());
+        assert_eq!(fs::read(target).unwrap(), b"target bytes");
+        assert!(fs::symlink_metadata(path).unwrap().file_type().is_symlink());
+    }
+}
