new file mode 100644
index 0000000..f0c762b
--- /dev/null
+++ 2/tests/result-json-harness/test_build_monitor.py
@@ -0,0 +1,68 @@
+"""Deterministic filesystem-race checks for the app-owned build monitor."""
+import importlib.util
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+location = Path(sys.argv.pop(1)) if len(sys.argv) > 1 else Path(__file__).resolve().parents[4] / "tools/build_engine.py"
+spec = importlib.util.spec_from_file_location("build_engine", location)
+build_engine = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(build_engine)
+
+
+class DiskMonitorTests(unittest.TestCase):
+    def test_file_disappearing_during_checkout_is_ignored(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            vanishing = root / "vanishing"
+            vanishing.write_bytes(b"123")
+            original = Path.is_file
+            removed = False
+
+            def is_file_then_remove(path, *args, **kwargs):
+                nonlocal removed
+                result = original(path, *args, **kwargs)
+                if path == vanishing and result and not removed:
+                    removed = True
+                    vanishing.unlink()
+                return result
+
+            failure = None
+            size = None
+            with patch.object(Path, "is_file", is_file_then_remove):
+                try:
+                    size = build_engine.disk_bytes(root)
+                except FileNotFoundError as error:
+                    failure = error
+            self.assertTrue(removed, "race was exercised")
+            self.assertIsNone(failure, "disk monitor must tolerate a file removed during checkout")
+            self.assertEqual(size, 0)
+
+    def test_existing_files_are_counted_and_symlinks_are_excluded(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            (root / "data").write_bytes(b"1234")
+            (root / "link").symlink_to(root / "data")
+            self.assertEqual(build_engine.disk_bytes(root), 4)
+
+    def test_other_io_errors_are_preserved(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            target = root / "data"
+            target.write_bytes(b"1234")
+            original = Path.stat
+
+            def denied(path, *args, **kwargs):
+                if path == target:
+                    raise PermissionError("synthetic denied file")
+                return original(path, *args, **kwargs)
+
+            with patch.object(Path, "stat", denied):
+                with self.assertRaises(PermissionError):
+                    build_engine.disk_bytes(root)
+
+
+if __name__ == "__main__":
+    unittest.main()
