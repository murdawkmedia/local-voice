+#[allow(dead_code, unused_imports)]
+#[path = "../../src/cli/mod.rs"]
+mod cli;
+
+use clap::Parser;
+
+#[test]
+fn result_json_option_is_explicitly_accepted_for_each_local_engine() {
+    for engine in ["whisper", "parakeet"] {
+        assert!(
+            cli::Cli::try_parse_from([
+                "voxtype",
+                "transcribe",
+                "generated.wav",
+                "--engine",
+                engine,
+                "--result-json",
+                "/private/job/result.json"
+            ])
+            .is_ok(),
+            "--result-json must be recognized for {engine}"
+        );
+    }
+}
+
+#[test]
+fn result_json_option_is_not_accepted_for_daemon() {
+    assert!(
+        cli::Cli::try_parse_from(["voxtype", "daemon", "--result-json", "result.json"]).is_err()
+    );
+}
diff --git 1/tests/result-json-harness/check_binary.py 2/tests/result-json-harness/check_binary.py
new file mode 100644
index 0000000..ff72b8a
--- /dev/null
+++ 2/tests/result-json-harness/check_binary.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Check the real CLI failure boundary without loading a model or recording audio."""
+from pathlib import Path
+import json
+import subprocess
+import sys
+import tempfile
+import wave
+
+
+def main() -> None:
+    binary = Path(sys.argv[1]).resolve(strict=True)
+    checks = []
+    with tempfile.TemporaryDirectory(prefix="voxtype-protocol-check-") as directory:
+        job = Path(directory)
+        job.chmod(0o700)
+        config = job / "config.toml"
+        config.write_text(f'''engine = "whisper"
+[whisper]
+model = "{job / 'absent-model.bin'}"
+mode = "local"
+gpu_isolation = false
+[vad]
+enabled = false
+[parakeet]
+model = "{job / 'absent-parakeet-model'}"
+model_type = "tdt"
+''')
+        config.chmod(0o600)
+        result = job / "result.json"
+        absent_audio = job / "absent.wav"
+
+        def invoke(audio: Path, engine: str = "whisper", cfg: Path = config) -> subprocess.CompletedProcess:
+            process = subprocess.run(
+                [str(binary), "--config", str(cfg), "transcribe", str(audio),
+                 "--engine", engine, "--result-json", str(result)],
+                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                timeout=15, check=False,
+            )
+            assert process.returncode != 0, "failed job returned success"
+            assert process.stdout == b"", "machine-mode diagnostics escaped to stdout"
+            return process
+
+        help_result = subprocess.run([str(binary), "transcribe", "--help"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10)
+        assert help_result.returncode == 0 and b"--result-json" in help_result.stdout
+        checks.append("result option in file-command help")
+
+        invoke(absent_audio)
+        assert not result.exists()
+        checks.append("missing input leaves no artifact or stdout")
+
+        result.write_bytes(b"preserve existing result")
+        process = invoke(absent_audio)
+        assert b"result destination already exists" in process.stderr
+        assert result.read_bytes() == b"preserve existing result"
+        result.unlink()
+        checks.append("existing destination preserved before input load")
+
+        remote = job / "remote.toml"
+        remote.write_text(config.read_text().replace('mode = "local"', 'mode = "remote"'))
+        process = invoke(absent_audio, cfg=remote)
+        assert b"requires whisper mode = local" in process.stderr and not result.exists()
+        checks.append("remote mode rejected before input/model/network use")
+
+        process = invoke(absent_audio, engine="soniox")
+        assert b"supports only local whisper and parakeet" in process.stderr and not result.exists()
+        checks.append("unsupported engine rejected before backend use")
+
+        invalid = job / "invalid.wav"
+        invalid.write_bytes(b"generated non-WAV input")
+        invoke(invalid)
+        assert not result.exists()
+        checks.append("invalid WAV leaves no artifact")
+
+        generated = job / "generated-silence.wav"
+        with wave.open(str(generated), "wb") as audio:
+            audio.setnchannels(1)
+            audio.setsampwidth(2)
+            audio.setframerate(16000)
+            audio.writeframes(b"\0\0" * 160)
+        for engine in ("whisper", "parakeet"):
+            process = invoke(generated, engine=engine)
+            assert b"model" in process.stderr.lower(), "expected a missing-model error"
+            assert not result.exists()
+            checks.append(f"{engine} missing model fails without artifact")
+
+        legacy = subprocess.run([str(binary), "--config", str(config), "transcribe", str(absent_audio)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10)
+        assert legacy.returncode != 0 and b"Loading audio file:" in legacy.stdout
+        checks.append("legacy human CLI keeps stdout banner")
+        assert not list(job.glob(".voxtype-result-*")), "failure left a temporary result"
+    print(json.dumps({"schemaVersion": 1, "checksPassed": len(checks), "checks": checks, "recognitionRun": False}))
+
+
+if __name__ == "__main__":
+    main()
